<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F7F8FA">

    <!-- TOP BAR -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="65dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:background="#FFFFFF">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="NutriLens AI"
                android:textSize="21sp"
                android:textStyle="bold"
                android:textColor="#202124"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Smart Nutrition"
                android:textSize="11sp"
                android:textColor="#777777"/>

        </LinearLayout>

        <TextView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:gravity="center"
            android:text="🔔"
            android:textSize="20sp"/>

        <TextView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:gravity="center"
            android:text="👤"
            android:textSize="20sp"/>

    </LinearLayout>


    <!-- SCROLLABLE CONTENT -->

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- GREETING -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Hello! 👋"
                android:textSize="26sp"
                android:textStyle="bold"
                android:textColor="#202124"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Here's your nutrition summary for today."
                android:textSize="14sp"
                android:textColor="#777777"
                android:layout_marginTop="4dp"/>


            <!-- CALORIES CARD -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="150dp"
                android:layout_marginTop="20dp"
                android:orientation="vertical"
                android:padding="20dp"
                android:background="#FFFFFF">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="DAILY CALORIES"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="#777777"/>

                <TextView
                    android:id="@+id/tvCalories"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0 / 2000 kcal"
                    android:textSize="27sp"
                    android:textStyle="bold"
                    android:textColor="#202124"
                    android:layout_marginTop="10dp"/>

                <ProgressBar
                    android:id="@+id/calorieProgress"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="10dp"
                    android:layout_marginTop="15dp"
                    android:max="2000"
                    android:progress="0"/>

                <TextView
                    android:id="@+id/tvCaloriePercent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0% of Daily Calories"
                    android:textSize="12sp"
                    android:textColor="#777777"
                    android:layout_marginTop="6dp"/>

            </LinearLayout>


            <!-- MACROS TITLE -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TODAY'S MACROS"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#777777"
                android:layout_marginTop="25dp"/>


            <!-- MACROS -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="120dp"
                android:orientation="horizontal"
                android:layout_marginTop="10dp">

                <!-- PROTEIN -->

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="#FFFFFF">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="PROTEIN"
                        android:textSize="11sp"
                        android:textColor="#777777"/>

                    <TextView
                        android:id="@+id/tvProtein"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0 g"
                        android:textSize="21sp"
                        android:textStyle="bold"
                        android:textColor="#202124"
                        android:layout_marginTop="8dp"/>

                </LinearLayout>


                <!-- CARBS -->

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:layout_marginStart="8dp"
                    android:background="#FFFFFF">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="CARBS"
                        android:textSize="11sp"
                        android:textColor="#777777"/>

                    <TextView
                        android:id="@+id/tvCarbs"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0 g"
                        android:textSize="21sp"
                        android:textStyle="bold"
                        android:textColor="#202124"
                        android:layout_marginTop="8dp"/>

                </LinearLayout>


                <!-- FAT -->

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:layout_marginStart="8dp"
                    android:background="#FFFFFF">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="FAT"
                        android:textSize="11sp"
                        android:textColor="#777777"/>

                    <TextView
                        android:id="@+id/tvFat"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0 g"
                        android:textSize="21sp"
                        android:textStyle="bold"
                        android:textColor="#202124"/>

                </LinearLayout>

            </LinearLayout>


            <!-- HEALTH CARDS -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="120dp"
                android:orientation="horizontal"
                android:layout_marginTop="10dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="#FFFFFF">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="BMI"
                        android:textSize="11sp"
                        android:textColor="#777777"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="23.0"
                        android:textSize="23sp"
                        android:textStyle="bold"
                        android:textColor="#202124"
                        android:layout_marginTop="7dp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Normal"
                        android:textSize="11sp"
                        android:textColor="#777777"/>

                </LinearLayout>


                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:layout_marginStart="8dp"
                    android:background="#FFFFFF">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="WATER"
                        android:textSize="11sp"
                        android:textColor="#777777"/>

                    <TextView
                        android:id="@+id/tvWater"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0 / 2500 ml"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="#202124"
                        android:layout_marginTop="7dp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Stay hydrated"
                        android:textSize="11sp"
                        android:textColor="#777777"/>

                </LinearLayout>

            </LinearLayout>


            <!-- QUICK ACTION -->

            <Button
                android:id="@+id/btnAddFood"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:text="+  ADD FOOD"
                android:textStyle="bold"
                android:layout_marginTop="20dp"/>
            <Button
                android:id="@+id/btnFoodHistory"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="VIEW FOOD HISTORY" />


        </LinearLayout>

    </ScrollView>


    <!-- BOTTOM NAVIGATION -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="65dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:background="#FFFFFF">

        <TextView
            android:id="@+id/navHome"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="⌂\nHome"
            android:textSize="12sp"/>

        <TextView
            android:id="@+id/navFood"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="🍎\nFood"
            android:textSize="12sp"/>

        <TextView
            android:id="@+id/navScale"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="⚖\nScale"
            android:textSize="12sp"/>

        <TextView
            android:id="@+id/navScan"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="▣\nScan"
            android:textSize="12sp"/>

        <TextView
            android:id="@+id/navCoach"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="🤖\nCoach"
            android:textSize="12sp"/>

    </LinearLayout>

</LinearLayout>