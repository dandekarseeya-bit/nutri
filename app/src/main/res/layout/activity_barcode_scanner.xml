<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F7F9FC">

    <!-- Top Bar -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:background="#FFFFFF">

        <Button
            android:id="@+id/btnBarcodeBack"
            android:layout_width="50dp"
            android:layout_height="wrap_content"
            android:text="←"
            android:textSize="20sp"/>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Barcode Scanner"
            android:textSize="20sp"
            android:textStyle="bold"/>

        <View
            android:layout_width="50dp"
            android:layout_height="1dp"/>

    </LinearLayout>


    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">


            <!-- Scanner Icon -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="▣"
                android:textSize="60sp"
                android:gravity="center"
                android:layout_marginTop="10dp"/>


            <!-- Title -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Scan a food barcode"
                android:textSize="20sp"
                android:textStyle="bold"
                android:gravity="center"
                android:layout_marginTop="5dp"/>


            <!-- Description -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Point your camera at the barcode on packaged food."
                android:textSize="14sp"
                android:gravity="center"
                android:padding="10dp"/>


            <!-- Camera Preview -->

            <androidx.camera.view.PreviewView
                android:id="@+id/previewView"
                android:layout_width="match_parent"
                android:layout_height="300dp"
                android:layout_marginTop="15dp"
                android:background="#000000"/>


            <!-- Scan Button -->

            <Button
                android:id="@+id/btnStartBarcodeScan"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:text="SCAN BARCODE"
                android:textSize="16sp"
                android:layout_marginTop="20dp"/>


            <!-- Barcode Number -->

            <TextView
                android:id="@+id/tvBarcodeNumber"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Barcode: Not scanned"
                android:textSize="16sp"
                android:gravity="center"
                android:padding="15dp"
                android:layout_marginTop="20dp"
                android:background="#FFFFFF"/>


            <!-- Product -->

            <TextView
                android:id="@+id/tvBarcodeProduct"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Product: Not scanned"
                android:textSize="18sp"
                android:textStyle="bold"
                android:padding="15dp"
                android:layout_marginTop="10dp"
                android:background="#FFFFFF"/>


            <!-- Calories -->

            <TextView
                android:id="@+id/tvBarcodeCalories"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Calories: --"
                android:textSize="16sp"
                android:padding="12dp"
                android:background="#FFFFFF"
                android:layout_marginTop="15dp"/>


            <!-- Protein -->

            <TextView
                android:id="@+id/tvBarcodeProtein"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Protein: --"
                android:textSize="16sp"
                android:padding="12dp"
                android:background="#FFFFFF"/>


            <!-- Carbs -->

            <TextView
                android:id="@+id/tvBarcodeCarbs"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Carbs: --"
                android:textSize="16sp"
                android:padding="12dp"
                android:background="#FFFFFF"/>


            <!-- Fat -->

            <TextView
                android:id="@+id/tvBarcodeFat"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Fat: --"
                android:textSize="16sp"
                android:padding="12dp"
                android:background="#FFFFFF"/>


            <!-- Serving Size -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Serving Size (grams)"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginTop="20dp"/>


            <EditText
                android:id="@+id/etBarcodeWeight"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:hint="Example: 100"
                android:inputType="numberDecimal"
                android:padding="12dp"/>


            <!-- Meal Type -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Meal Type"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginTop="20dp"/>


            <Spinner
                android:id="@+id/spinnerBarcodeMealType"
                android:layout_width="match_parent"
                android:layout_height="55dp"/>


            <!-- Save -->

            <Button
                android:id="@+id/btnSaveBarcodeMeal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="SAVE MEAL"
                android:textSize="16sp"
                android:layout_marginTop="25dp"
                android:layout_marginBottom="20dp"/>

        </LinearLayout>

    </ScrollView>

</LinearLayout>

