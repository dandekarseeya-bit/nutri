<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F7F9FC">

    <!-- Back Button -->

    <Button
        android:id="@+id/btnBack"
        android:layout_width="55dp"
        android:layout_height="50dp"
        android:text="←"
        android:textSize="22sp"
        android:textColor="#222222"
        android:backgroundTint="#FFFFFF"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginStart="12dp"
        android:layout_marginTop="12dp" />

    <!-- Title -->

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Food History"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="#222222"
        android:gravity="center"
        app:layout_constraintStart_toEndOf="@id/btnBack"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/btnBack"
        app:layout_constraintBottom_toBottomOf="@id/btnBack"
        android:layout_marginEnd="65dp" />

    <!-- Information -->

    <TextView
        android:id="@+id/tvHistoryInfo"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Your saved meals"
        android:textSize="16sp"
        android:textColor="#666666"
        android:padding="8dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btnBack"
        android:layout_marginTop="12dp"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp" />

    <!-- TODAY'S NUTRITION -->

    <TextView
        android:id="@+id/tvTodaySummaryTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="TODAY'S NUTRITION"
        android:textSize="12sp"
        android:textStyle="bold"
        android:textColor="#777777"
        app:layout_constraintTop_toBottomOf="@id/tvHistoryInfo"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginStart="20dp"
        android:layout_marginTop="8dp" />

    <!-- Nutrition Cards -->

    <LinearLayout
        android:id="@+id/layoutNutritionSummary"
        android:layout_width="0dp"
        android:layout_height="90dp"
        android:orientation="horizontal"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/tvTodaySummaryTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/tvHistoryCalories"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="0 kcal"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#222222"
            android:background="#FFFFFF" />

        <TextView
            android:id="@+id/tvHistoryProtein"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:gravity="center"
            android:text="0 g\nProtein"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#222222"
            android:background="#FFFFFF" />

        <TextView
            android:id="@+id/tvHistoryCarbs"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:gravity="center"
            android:text="0 g\nCarbs"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#222222"
            android:background="#FFFFFF" />

        <TextView
            android:id="@+id/tvHistoryFat"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:gravity="center"
            android:text="0 g\nFat"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#222222"
            android:background="#FFFFFF" />

    </LinearLayout>

    <!-- Nutrition Analytics Button -->

    <Button
        android:id="@+id/btnAnalytics"
        android:layout_width="0dp"
        android:layout_height="50dp"
        android:text="View Nutrition Analytics"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:backgroundTint="#4CAF50"
        app:layout_constraintTop_toBottomOf="@id/layoutNutritionSummary"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginTop="12dp" />

    <!-- Saved Meals Label -->

    <TextView
        android:id="@+id/tvSavedMealsTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="SAVED MEALS"
        android:textSize="12sp"
        android:textStyle="bold"
        android:textColor="#777777"
        app:layout_constraintTop_toBottomOf="@id/btnAnalytics"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginStart="20dp"
        android:layout_marginTop="16dp" />

    <!-- Food List -->

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerFoodHistory"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:padding="12dp"
        app:layout_constraintTop_toBottomOf="@id/tvSavedMealsTitle"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
