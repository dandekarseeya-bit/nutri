<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F7F9FC">

    ```
    <!-- TOP BAR -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:background="#FFFFFF">

        <Button
            android:id="@+id/btnCoachBack"
            android:layout_width="50dp"
            android:layout_height="wrap_content"
            android:text="←"
            android:textSize="20sp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="AI Health Coach"
            android:textSize="20sp"
            android:textStyle="bold" />

        <View
            android:layout_width="50dp"
            android:layout_height="1dp" />

    </LinearLayout>


    <!-- CONTENT -->

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- AI ICON -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🤖"
                android:textSize="60sp"
                android:gravity="center"
                android:layout_marginTop="15dp" />

            <!-- TITLE -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Your AI Nutrition Coach"
                android:textSize="24sp"
                android:textStyle="bold"
                android:gravity="center"
                android:layout_marginTop="10dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Ask me anything about your nutrition and meals."
                android:textSize="15sp"
                android:gravity="center"
                android:padding="10dp" />


            <!-- TODAY'S NUTRITION -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Today's Nutrition"
                android:textSize="19sp"
                android:textStyle="bold"
                android:layout_marginTop="20dp" />


            <!-- CALORIES + PROTEIN -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="10dp">

                <TextView
                    android:id="@+id/tvCoachCalories"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Calories&#10;0 kcal"
                    android:textSize="15sp"
                    android:gravity="center"
                    android:padding="15dp"
                    android:background="#FFFFFF" />

                <TextView
                    android:id="@+id/tvCoachProtein"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Protein&#10;0 g"
                    android:textSize="15sp"
                    android:gravity="center"
                    android:padding="15dp"
                    android:layout_marginStart="8dp"
                    android:background="#FFFFFF" />

            </LinearLayout>


            <!-- CARBS + FAT -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="8dp">

                <TextView
                    android:id="@+id/tvCoachCarbs"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Carbs&#10;0 g"
                    android:textSize="15sp"
                    android:gravity="center"
                    android:padding="15dp"
                    android:background="#FFFFFF" />

                <TextView
                    android:id="@+id/tvCoachFat"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Fat&#10;0 g"
                    android:textSize="15sp"
                    android:gravity="center"
                    android:padding="15dp"
                    android:layout_marginStart="8dp"
                    android:background="#FFFFFF" />

            </LinearLayout>


            <!-- ASK SECTION -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Ask your coach"
                android:textSize="19sp"
                android:textStyle="bold"
                android:layout_marginTop="25dp" />

            <EditText
                android:id="@+id/etCoachQuestion"
                android:layout_width="match_parent"
                android:layout_height="120dp"
                android:hint="Example: What should I eat for dinner?"
                android:gravity="top|start"
                android:padding="15dp"
                android:inputType="textMultiLine"
                android:background="#FFFFFF" />


            <!-- ASK BUTTON -->

            <Button
                android:id="@+id/btnAskCoach"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:text="ASK AI COACH"
                android:textSize="16sp"
                android:layout_marginTop="15dp"
                android:clickable="true"
                android:focusable="true" />


            <!-- RESPONSE TITLE -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Coach's Response"
                android:textSize="19sp"
                android:textStyle="bold"
                android:layout_marginTop="25dp" />


            <!-- RESPONSE BOX -->

            <TextView
                android:id="@+id/tvCoachResponse"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="180dp"
                android:text="Your AI coach's response will appear here."
                android:textSize="16sp"
                android:textColor="#000000"
                android:gravity="top|start"
                android:padding="18dp"
                android:lineSpacingExtra="5dp"
                android:background="#FFFFFF"
                android:layout_marginTop="10dp"
                android:visibility="visible" />

        </LinearLayout>

    </ScrollView>
    ```

</LinearLayout>
